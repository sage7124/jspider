// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums natively

model User {
  id             Int          @id @default(autoincrement())
  role           String       @default("TRAINEE")
  fullName       String
  identifier     String       @unique // Mobile for Admin, Registration No for Trainee
  email          String?      @unique
  department     String?
  password       String
  plainPassword  String?
  isApproved     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leaveBalance   Int          @default(0)
  totalLeaves    Int          @default(0)
  
  mobileDeviceId String?      @unique
  desktopDeviceId String?     @unique
  
  // 3-day lock override
  editAccessGrantedUntil DateTime?
  
  // 21 Onboarding fields
  photoUrl               String?
  officeTimings          String?
  dateOfJoining          String?
  aadhaarNumber          String?
  aadhaarPhotoUrl        String?
  panNumber              String?
  panPhotoUrl            String?
  bankName               String?
  bankAccountNo          String?
  bankIfscCode           String?
  bankBranchName         String?
  emergencyContactName   String?
  emergencyContactMobile String?
  fatherName             String?
  motherName             String?
  presentAddress         String?
  permanentAddress       String?
  educationCompleted     String?
  subClassification      String?
  baseSalary             Float        @default(0.0)
  trainingFee            Float        @default(0.0)
  lateRate               Float?
  earlyRate              Float?
  absentRate             Float?
  
  permissions            String       @default("RESET_PASSWORD,DIRECT_LEAVE,DOWNLOAD_REPORT")
  
  activeSessionToken     String?      // Only one active session allowed at a time (Trainees only)
  
  slots          Slot[]       // Slots assigned to this trainee
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  notices        Notice[]
  memosReceived  Memo[]       @relation("RecipientMemos")
  memosSent      Memo[]       @relation("SenderMemos")
  breakLogs      BreakLog[]
  extraClassLogs         ExtraClassLog[]
  classCancelledLogs     ClassCancelledLog[]
  otherCenterClassLogs   OtherCenterClassLog[]
  supervisors    User[]       @relation("SupervisorTrainees")
  trainees       User[]       @relation("SupervisorTrainees")
  isDisabled             Boolean      @default(false)
  disableReason          String?
  hasLeft                Boolean      @default(false)
  disableLogs            DisableLog[] @relation("UserDisableLogs")
  disabledByLogs         DisableLog[] @relation("AdminDisableLogs")
  salarySlips            SalarySlip[]
}

model LeaveRequest {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  startDate      DateTime
  endDate        DateTime
  reason         String?
  adminReason    String?      // Optional reason given by admin when approving/rejecting
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  
  appliedDate        DateTime?
  remarksAlternative String?
  remarksOfficeUse   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Slot {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  dayOfWeek      String       // e.g., "MON", "TUE"
  slotNo         Int          @default(1) // 1, 2, or 3
  startTime      String       // e.g., "07:00 AM"
  endTime        String       // e.g., "08:00 PM"
  createdAt      DateTime     @default(now())
  
  @@unique([userId, dayOfWeek, slotNo])
}

model Attendance {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  date           DateTime     

  inTime         DateTime?    // Overall first punch in
  outTime        DateTime?    // Overall last punch out
  status         String       @default("IN") // IN, OUT
  isLate         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Slot specific punches
  inTime1        DateTime?
  outTime1       DateTime?
  inBranch1      String?
  outBranch1     String?
  inTime2        DateTime?
  outTime2       DateTime?
  inBranch2      String?
  outBranch2     String?
  inTime3        DateTime?
  outTime3       DateTime?
  inBranch3      String?
  outBranch3     String?
  inTime4        DateTime?
  outTime4       DateTime?
  inTime5        DateTime?
  outTime5       DateTime?

  // Real / Original geofenced punch timings
  realInTime1    DateTime?
  realOutTime1   DateTime?
  realInTime2    DateTime?
  realOutTime2   DateTime?
  realInTime3    DateTime?
  realOutTime3   DateTime?
  realInTime4    DateTime?
  realOutTime4   DateTime?
  realInTime5    DateTime?
  realOutTime5   DateTime?


  info           String?
  info1          String?
  info2          String?
  info3          String?
  info4          String?
  info5          String?

  @@unique([userId, date])
}

model InstituteSettings {
  id             Int      @id @default(1)
  lat            Float    @default(12.9716)
  lng            Float    @default(77.5946)
  radius         Int      @default(500) // Meters
  lat2           Float    @default(12.9716)
  lng2           Float    @default(77.5946)
  radius2        Int      @default(500) // Meters
  totalHolidaysQuota Int    @default(0)
  lateRate       Float    @default(30.0)
  earlyRate      Float    @default(30.0)
  absentRate     Float    @default(0.0) // 0.0 means calculate dynamically based on daily rate (baseSalary / daysInMonth)
  updatedAt      DateTime @updatedAt
}

model Holiday {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique
  name           String
  createdAt      DateTime @default(now())
}

model Notice {
  id             Int      @id @default(autoincrement())
  message        String
  fromDate       DateTime
  toDate         DateTime
  userId         Int?     // null means for everyone
  user           User?    @relation(fields: [userId], references: [id])
  targetGroup    String   @default("ALL") // "ALL", "SUPERVISOR", "TRAINEE"
  createdAt      DateTime @default(now())
}

model DropdownOption {
  id        Int      @id @default(autoincrement())
  type      String   // "EDUCATION" or "CLASSIFICATION"
  value     String   @unique
  createdAt DateTime @default(now())
}

model BranchLocation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  branchCode String?
  kioskDeviceId String? @unique
  lat       Float
  lng       Float
  radius    Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Memo {
  id             Int      @id @default(autoincrement())
  content        String
  recipientId    Int
  recipient      User     @relation("RecipientMemos", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User     @relation("SenderMemos", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model BreakLog {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  breakOut      DateTime
  breakIn       DateTime?
  reason        String?
  status        String    @default("APPROVED") // APPROVED, PENDING, REJECTED
  
  // College Visit structured fields
  bookletNo     String?
  collegeName   String?
  subject       String?
  topicsCovered String?
  conveyance    String?
  numberOfHours String?
  fromTime      String?
  toTime        String?
  
  createdAt     DateTime  @default(now())
}

model ExtraClassLog {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  day           String
  subject       String
  batchNo       String
  duration      Float     // Duration in hours
  startTime     String    // 12-hour format string (e.g. 10:00 AM)
  endTime       String    // 12-hour format string (e.g. 11:30 AM)
  noOfStudents  Int
  centerName    String    // NICT Center Name
  remarks       String?
  classMode     String    @default("OFFLINE") // "ONLINE" or "OFFLINE"
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminReason   String?   // Supervisor approval/rejection remarks
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ClassCancelledLog {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  day           String
  subject       String
  batchNo       String
  centerName    String    // NICT Center Name
  reason        String    @default("Other reasons")
  remarks       String?
  createdAt     DateTime  @default(now())
}

model OtherCenterClassLog {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  day           String
  subject       String
  batchNo       String
  duration      Float     // Duration in hours
  startTime     String    // 12-hour format string (e.g. 10:00 AM)
  endTime       String    // 12-hour format string (e.g. 11:30 AM)
  noOfStudents  Int
  centerName    String    // NICT Center Name
  remarks       String?
  classMode     String    @default("OFFLINE") // "ONLINE" or "OFFLINE"
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminReason   String?   // Supervisor approval/rejection remarks
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DisableLog {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("UserDisableLogs", fields: [userId], references: [id], onDelete: Cascade)
  disabledAt   DateTime  @default(now())
  enabledAt    DateTime?
  reason       String
  disabledById Int
  disabledBy   User      @relation("AdminDisableLogs", fields: [disabledById], references: [id], onDelete: Cascade)
}

model SalarySlip {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month            String   // Format: "YYYY-MM"
  basicSalary      Float    @default(0.0)
  hra              Float    @default(0.0)
  conveyance       Float    @default(0.0)
  specialAllowance Float    @default(0.0)
  otherAllowance   Float    @default(0.0)
  pf               Float    @default(0.0)
  professionalTax  Float    @default(0.0)
  esi              Float    @default(0.0)
  tds              Float    @default(0.0)
  otherDeductions  Float    @default(0.0)
  netSalary        Float    @default(0.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month])
}

